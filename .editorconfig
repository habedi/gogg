# https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
max_line_length = 100

[*.md]
max_line_length = 120
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[*.ps1]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2
